pragma circom 2.0.0;

// 引入 circomlib 官方的哈希和树验证组件
include "../circomlib/circuits/poseidon.circom";
include "../circomlib/circuits/merkleTree.circom";

template PrivacyPool() {
    // ============ 公开输入 (Public Inputs) ============
    // 1. 当前树的根 (证明存款存在)
    signal input root;
    // 2. 作废码哈希 (防止双花攻击)
    signal input nullifierHash;
    // 3. 接收者地址 (防止被抢跑)
    signal input recipient;
    // 4. 提现金额标识 (固定面额，如 100 USDT)
    signal input amount; 

    // ============ 私有输入 (Private Inputs) ============
    // 暗号组成部分 (绝不上链)
    signal input nullifier;
    signal input secret;
    
    // 默克尔树验证路径 (证明这个暗号在树里)
    signal input pathElements[20];
    signal input pathIndices[20];

    // ============ 1. 验证 Commitment ============
    // 暗号哈希 = Poseidon(作废码, 私钥, 金额)
    component commitmentHasher = Poseidon(3);
    commitmentHasher.inputs[0] <== nullifier;
    commitmentHasher.inputs[1] <== secret;
    commitmentHasher.inputs[2] <== amount;
    
    signal commitment <== commitmentHasher.out;

    // ============ 2. 验证作废码哈希 ============
    component nullifierHasher = Poseidon(1);
    nullifierHasher.inputs[0] <== nullifier;
    nullifierHash === nullifierHasher.out;

    // ============ 3. 验证地址绑定 ============
    // 将接收地址与作废码绑定，防止黑客截胡提现
    component recipientHasher = Poseidon(2);
    recipientHasher.inputs[0] <== nullifierHash;
    recipientHasher.inputs[1] <== recipient;
    // 这里我们将 recipient 作为一个公开信号，确保这笔钱只能由指定的地址提走
    // (生产环境中通常会在合约层校验 recipient 与 msg.sender 的关联)

    // ============ 4. 验证默克尔树 ============
    // 证明 commitment 在 root 为当前的树上
    component tree = MerkleTreeChecker(20);
    tree.leaf <== commitment;
    tree.root <== root;
    for (var i = 0; i < 20; i++) {
        tree.pathElements[i] <== pathElements[i];
        tree.pathIndices[i] <== pathIndices[i];
    }
}

component main = PrivacyPool();